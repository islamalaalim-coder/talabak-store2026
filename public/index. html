<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>طلبك | متجر إلكتروني</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<header>
  <div class="logo">🛍️ طلبك</div>

  <input id="search" type="text"
    placeholder="ابحث عن منتج..."
    oninput="loadProducts()">

  <button onclick="showCart()">🛒 السلة <span id="cartCount">0</span></button>
</header>

<section class="hero">
  <h1>أهلاً بك في طلبك</h1>
  <p>كل ما تحتاجه في مكان واحد</p>
  <button onclick="document.getElementById('products').scrollIntoView()">
    ابدأ التسوق
  </button>
</section>

<main>
  <h2>المنتجات</h2>
  <div id="products" class="products">
    جاري تحميل المنتجات...
  </div>
</main>

<div id="cart" class="cart">
  <div class="cart-box">
    <button onclick="closeCart()">✕</button>
    <h2>سلة التسوق</h2>
    <div id="cartItems"></div>
    <h3 id="total"></h3>
  </div>
</div>

<script src="/app.js"></script>
</body>
</html>
